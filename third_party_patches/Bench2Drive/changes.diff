+        self._agent = ConstantVelocityAgent(self._actor, target_speed=3.6 * v, map_inst=CarlaDataProvider.get_map(), grp_inst=CarlaDataProvider.get_global_route_planner())
+    def update(self):
+        self._actor.apply_control(self._agent.run_step()); return py_trees.common.Status.RUNNING
+    def terminate(self, new_status):
+        try: self._actor.disable_constant_velocity()
+        except Exception: pass
+        if self._agent: self._agent.destroy_sensor()

+class SmoothSyncArrival(SyncArrivalWithAgent):
+    """SyncArrivalWithAgent, but smooth: constant cruise speed until `sync_dist` m before its target, then the arrival-time
+    sync with the commanded speed rate-limited (max 2 m/s^2 accel, 3 m/s^2 decel) and clamped to [3, 22] m/s, so the NPC
+    never mirrors the ego's stop-and-go."""
+    def __init__(self, actor, reference_actor, actor_target, reference_target, end_dist=1, sync_dist=45.0, cruise=14.0, name="SmoothSyncArrival"):
+        super().__init__(actor, reference_actor, actor_target, reference_target, end_dist, name)
+        self._sync_dist = sync_dist; self._cruise = cruise; self._v_cmd = None; self._dt = 0.05
+
+    def update(self):
+        import py_trees
+        from srunner.scenariomanager.carla_data_provider import CarlaDataProvider
+        from srunner.scenariomanager.scenarioatomics.atomic_behaviors import calculate_distance
+        loc = CarlaDataProvider.get_location(self._actor); distance = calculate_distance(loc, self._actor_target.location)
+        # finish as soon as the NPC reaches (or has passed) ITS cut-in point - regardless of where the ego is - so the
+        # post-sync behaviour (fast, steady lane keeping) takes over there and the NPC never lingers next to the ego
+        to_target = self._actor_target.location - loc; fwd = CarlaDataProvider.get_transform(self._actor).get_forward_vector()
+        import time as _t
+        if not hasattr(self, '_t_log') or _t.time() - self._t_log > 2.0:
+            self._t_log = _t.time(); print(f'[SmoothSync] dist_to_cutin_point={distance:.1f} m  npc_speed={CarlaDataProvider.get_velocity(self._actor):.1f} m/s  ego_speed={CarlaDataProvider.get_velocity(self._reference_actor):.1f} m/s', flush=True)
+        if distance < max(self._end_dist, 3.0) or (to_target.x * fwd.x + to_target.y * fwd.y) < 0:
+            # the sync uses CARLA's ConstantVelocityAgent, which pins the actor to a constant velocity (physics override) -
+            # switch that off, otherwise the follower's throttle has no effect and the NPC stays at the last synced speed
+            try: self._actor.disable_constant_velocity()
+            except Exception: pass
+            print('[SmoothSync] reached the cut-in point -> SUCCESS (fast lane keeping starts)', flush=True); return py_trees.common.Status.SUCCESS
+        if distance > self._sync_dist:
+            desired = self._cruise
+        else:
+            distance_reference = calculate_distance(CarlaDataProvider.get_location(self._reference_actor), self._reference_target.location)
+            velocity_reference = CarlaDataProvider.get_velocity(self._reference_actor)
+            desired = distance / (distance_reference / velocity_reference) if velocity_reference > 0.5 else 3.0
+        desired = min(max(desired, 3.0), 22.0)
+        if self._v_cmd is None: self._v_cmd = CarlaDataProvider.get_velocity(self._actor) or self._cruise
+        self._v_cmd += min(max(desired - self._v_cmd, -3.0 * self._dt), 2.0 * self._dt)   # rate limit
+        self._agent.set_target_speed(3.6 * self._v_cmd)
+        self._actor.apply_control(self._agent.run_step())
+        return py_trees.common.Status.RUNNING
+
+
+class NpcSpeedLogger(py_trees.behaviour.Behaviour):
+    """Debug: print the NPC speed / lane every 2 s while the post-sync lane keeping runs (never finishes by itself)."""
+    def __init__(self, actor, name="NpcSpeedLogger"):
+        super().__init__(name); self._actor = actor; self._t = 0.0
+    def update(self):
+        import time as _t
+        if _t.time() - self._t > 2.0:
+            self._t = _t.time()
+            try:
+                v = CarlaDataProvider.get_velocity(self._actor); loc = CarlaDataProvider.get_location(self._actor)
+                wp = CarlaDataProvider.get_map().get_waypoint(loc); c = self._actor.get_control()
+                print(f'[KeepLane] npc_speed={v:.1f} m/s thr={c.throttle:.2f} brk={c.brake:.2f} road={wp.road_id} lane={wp.lane_id} junction={wp.is_junction}', flush=True)
+            except Exception as e: print('[KeepLane] log error', e, flush=True)
+        return py_trees.common.Status.RUNNING
+
+
+class ConstantMeet(py_trees.behaviour.Behaviour):
+    """Pick ONE constant speed at the start so the NPC reaches its cut-in point when the ego (at its current speed) reaches
+    its reference point; then hold that speed in its own lane for the whole scenario (no sync, no cut-in, no acceleration)."""
+    def __init__(self, actor, ego, actor_target, ego_target, fallback=14.0, name="ConstantMeet"):
+        super().__init__(name); self._actor = actor; self._ego = ego; self._actor_target = actor_target; self._ego_target = ego_target; self._fallback = fallback; self._agent = None
+    def initialise(self):
+        from srunner.scenariomanager.scenarioatomics.atomic_behaviors import calculate_distance
+        from agents.navigation.constant_velocity_agent import ConstantVelocityAgent
+        d_npc = calculate_distance(CarlaDataProvider.get_location(self._actor), self._actor_target.location)
+        d_ego = calculate_distance(CarlaDataProvider.get_location(self._ego), self._ego_target.location)
+        v_ego = CarlaDataProvider.get_velocity(self._ego)
+        v = d_npc * v_ego / d_ego if (v_ego > 1.0 and d_ego > 1.0) else self._fallback   # meet-at-point speed, one shot
+        self._v = min(max(v, 2.0), 25.0)
+        print(f'[ConstantMeet] npc {d_npc:.0f} m from its cut-in point, ego {d_ego:.0f} m at {v_ego:.1f} m/s -> NPC constant speed {self._v:.1f} m/s ({3.6*self._v:.0f} km/h) for the whole scenario', flush=True)
+        self._agent = ConstantVelocityAgent(self._actor, target_speed=3.6 * self._v, map_inst=CarlaDataProvider.get_map(), grp_inst=CarlaDataProvider.get_global_route_planner())
+    def update(self):
+        self._actor.apply_control(self._agent.run_step())   # lane following at the fixed constant velocity
+        return py_trees.common.Status.RUNNING
+    def terminate(self, new_status):
+        try: self._actor.disable_constant_velocity()
+        except Exception: pass
+        if self._agent: self._agent.destroy_sensor()
+
+
+class ConstantHold(py_trees.behaviour.Behaviour):
+    """Hold ONE constant speed in the current lane (CARLA constant-velocity mode): the speed the NPC has when this starts

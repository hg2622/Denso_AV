-
+# Profile for a HUMAN-driven ego (rift_drive.sh). The eval numbers above are tuned for a model that drives at a steady,
+# confident pace: a candidate only qualifies if its path length to an interaction point is within
+# min_interaction_dis_diff of the ego's, so a person who slows down, looks around or drives cautiously falls outside
+# that window and almost no NPC is ever taken over. This profile widens the gate and allows more concurrent CBVs.
+human:
+  spawn_radius: 50
+  traffic_intensity: 0.8        # denser traffic -> more candidates to choose from
+  activate_radius: 150
+  coord_interval: 60
+  search_radius: 80             # look further for candidates (was 60)
+  max_interaction_fov: 180      # a candidate may approach from any forward angle (was 150)
+  max_interaction_dis: 110      # interaction point may be further along the route (was 90)
+  min_interaction_dis_diff: 60  # KEY: tolerate a much larger arrival-distance mismatch (was 20)
+  max_route_len: 400
+  max_ego_route_len: 80         # consider more of the ego's remaining route (was 50)
+  max_agent_num: 4              # up to 4 adversaries at once (was 2)
+  down_sample_step: 4

+class LaneInvader(AtomicBehavior):
+    """custom: oncoming car that drifts into the ego lane and eases back (timer starts when the ego is within trigger_dist).
+    Lateral profile: 0 -> offset over t_in, hold t_hold, back to 0 over t_out. Pure-pursuit steering on its own lane, speed held."""
+    def __init__(self, actor, ego, speed, offset, start, t_in, t_hold, t_out, trigger_dist, name="LaneInvader"):
+        super().__init__(name, actor); self._ego = ego; self._v = speed; self._off = offset; self._start = start; self._in = t_in; self._hold = t_hold; self._out = t_out; self._trig = trigger_dist
+        self._t0 = None; self._map = CarlaDataProvider.get_map(); self._n = 0
+    def _target_offset(self, t):
+        if t < self._start: return 0.0
+        t -= self._start
+        if t < self._in: return self._off * t / self._in
+        t -= self._in
+        if t < self._hold: return self._off
+        t -= self._hold
+        if t < self._out: return self._off * (1.0 - t / self._out)
+        return 0.0
+    def update(self):
+        a = self._actor
+        if a is None or not a.is_alive: return py_trees.common.Status.SUCCESS
+        loc = a.get_location(); gap = loc.distance(self._ego.get_location()); now = GameTime.get_time()
+        if self._t0 is None and gap <= self._trig: self._t0 = now; print(f'[LaneInvader] trigger: gap {gap:.1f} m, drifting {self._off:.1f} m into the ego lane', flush=True)
+        off = self._target_offset(now - self._t0) if self._t0 is not None else 0.0
+        wp = self._map.get_waypoint(loc, project_to_road=True, lane_type=carla.LaneType.Driving); ctl = carla.VehicleControl()
+        nxt = wp.next(6.0) if wp is not None else []
+        if not nxt: ctl.brake = 1.0; a.apply_control(ctl); return py_trees.common.Status.RUNNING
+        tgt = nxt[0].transform; right = tgt.get_right_vector(); target = tgt.location - carla.Location(right.x * off, right.y * off, 0.0)
+        tf = a.get_transform(); fwd = tf.get_forward_vector(); d = target - tf.location
+        local_x = d.x * fwd.x + d.y * fwd.y; local_y = -d.x * fwd.y + d.y * fwd.x   # left-handed CARLA: positive = right

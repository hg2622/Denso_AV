+                print(f'[KeepLane] npc_speed={v:.1f} m/s thr={c.throttle:.2f} brk={c.brake:.2f} road={wp.road_id} lane={wp.lane_id} junction={wp.is_junction}', flush=True)
+            except Exception as e: print('[KeepLane] log error', e, flush=True)
+        return py_trees.common.Status.RUNNING
+

+class ConstantMeet(py_trees.behaviour.Behaviour):
+    """Pick ONE constant speed at the start so the NPC reaches its cut-in point when the ego (at its current speed) reaches
+    its reference point; then hold that speed in its own lane for the whole scenario (no sync, no cut-in, no acceleration)."""
+    def __init__(self, actor, ego, actor_target, ego_target, fallback=14.0, name="ConstantMeet"):
+        super().__init__(name); self._actor = actor; self._ego = ego; self._actor_target = actor_target; self._ego_target = ego_target; self._fallback = fallback; self._agent = None
+    def initialise(self):
+        from srunner.scenariomanager.scenarioatomics.atomic_behaviors import calculate_distance
+        from agents.navigation.constant_velocity_agent import ConstantVelocityAgent
+        d_npc = calculate_distance(CarlaDataProvider.get_location(self._actor), self._actor_target.location)
+        d_ego = calculate_distance(CarlaDataProvider.get_location(self._ego), self._ego_target.location)
+        v_ego = CarlaDataProvider.get_velocity(self._ego)
+        v = d_npc * v_ego / d_ego if (v_ego > 1.0 and d_ego > 1.0) else self._fallback   # meet-at-point speed, one shot
+        self._v = min(max(v, 2.0), 25.0)
+        print(f'[ConstantMeet] npc {d_npc:.0f} m from its cut-in point, ego {d_ego:.0f} m at {v_ego:.1f} m/s -> NPC constant speed {self._v:.1f} m/s ({3.6*self._v:.0f} km/h) for the whole scenario', flush=True)
+        self._agent = ConstantVelocityAgent(self._actor, target_speed=3.6 * self._v, map_inst=CarlaDataProvider.get_map(), grp_inst=CarlaDataProvider.get_global_route_planner())
+    def update(self):
+        self._actor.apply_control(self._agent.run_step())   # lane following at the fixed constant velocity
+        return py_trees.common.Status.RUNNING
+    def terminate(self, new_status):
+        try: self._actor.disable_constant_velocity()
+        except Exception: pass
+        if self._agent: self._agent.destroy_sensor()
+
+
